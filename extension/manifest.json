{
  "manifest_version": 3,
  "name": "Recruiter Quick Search",
  "version": "1.0.0",
  "description": "Highlight a company name and press Ctrl+Shift+Y to get an instant summary.",
  "permissions": ["activeTab", "scripting", "contextMenus"],
  "host_permissions": ["https://*.vercel.app/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Search highlighted company (Ctrl+Shift+Y)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Search highlighted company"
    }
  }
}